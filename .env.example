OPENAI_API_KEY=
TAVILY_API_KEY=

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional: comma-separated extra model ids exposed to Open WebUI's picker.
# Requests with a matching id hit that model; unknown ids fall back to OPENAI_MODEL.
# OPENAI_EXTRA_MODELS=gpt-4.1-mini,gpt-4o

# Browser tools (Playwright). Empty allowlist means every URL is permitted;
# set a comma-separated prefix list to lock browser_open/click/type down.
# BROWSER_ALLOWED_URL_PREFIXES=https://www.google.com/,https://en.wikipedia.org/
# BROWSER_HEADLESS=true
# BROWSER_NAV_TIMEOUT_S=30
